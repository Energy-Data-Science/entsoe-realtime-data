ENTSOE_API_KEY=replace_with_your_entsoe_api_key
ENTSOE_COUNTRIES=BE,FR,DE
ENTSOE_TIMEZONE=Europe/Brussels
ENTSOE_DATA_DIR=data/raw
ENTSOE_UPDATE_DIR=data/updates
ENTSOE_UPDATE_MANIFEST=data/update_manifest.csv
ENTSOE_RUN_HISTORY=data/run_history.csv
ENTSOE_STATUS_FILE=data/status.json
ENTSOE_FETCH_MODE=recent
ENTSOE_STORAGE_MODE=snapshot
ENTSOE_RECENT_DAYS=31
ENTSOE_CHUNK_DAYS=31
ENTSOE_SLEEP_SECONDS=1.0
ENTSOE_MAX_RETRIES=3
ENTSOE_RETRY_SLEEP_SECONDS=5.0
ENTSOE_MIN_CHUNK_HOURS=24
ENTSOE_REQUEST_TIMEOUT_SECONDS=60
ENTSOE_PROGRESS_FILE=data/progress.json

# Optional Mango/iRODS upload settings for machine-account automation.
# For personal interactive Mango login, prefer config/irods_environment.json
# or ~/.irods/irods_environment.json plus scripts/upload_to_mango.py --authenticate.
IRODS_HOST=replace_with_mango_irods_host
IRODS_PORT=1247
IRODS_USER=replace_with_mango_user_or_machine_account
IRODS_PASSWORD=replace_with_machine_account_password_or_token
IRODS_ZONE=replace_with_mango_zone
IRODS_AUTHENTICATION_SCHEME=
MANGO_LOCAL_ROOT=/Volumes/PSSD/1_entsoe-realtime-data-archive/data-branch-work/data/updates
MANGO_REMOTE_ROOT=/set/home/Transparency_plus/ingress/entsoe-realtime-data-archive/data-branch-work/data/updates
MANGO_UPLOAD_MANIFEST=data/mango_upload_manifest.csv
